        '👥 Equipa': '👥 Team',
        '👥 Rede Profissional': '👥 Professional Network',
        '💬 Enviar Mensagem': '💬 Send Message',
        '💬 Mensagem': '💬 Message',
        '💬 Nova Conversa': '💬 New Conversation',
        '🤝 As Minhas Ligações': '🤝 My Connections',
        '⭐ Avaliações': '⭐ Reviews',
        '📊 Resumo': '📊 Summary',
        '📋 As Minhas Candidaturas': '📋 My Applications',
        '🏢 Informação da empresa': '🏢 Company information',
        '✏️ Editar Oportunidade': '✏️ Edit Opportunity',
        '✏️ Editar Perfil': '✏️ Edit Profile',
        '🟢 Disponível para trabalhar': '🟢 Open to work',
        '🔍 Nenhuma oportunidade encontrada para os filtros aplicados.': '🔍 No opportunities found for the selected filters.',
        'Acompanha o estado das tuas candidaturas a empregos.': 'Track the status of your job applications.',
    };

    var currentLang = 'pt';
    // Maps each modified DOM node (text node, input, textarea) → its original value
    var saved = new Map();

    // Translate a single text node's content
    function translateTextNode(node, dict) {
        var orig = node.textContent;
        var trimmed = orig.trim();
        if (!trimmed) return;
        // 1. Exact trimmed match
        if (dict[trimmed] !== undefined) {
            if (!saved.has(node)) saved.set(node, orig);
            node.textContent = orig.replace(trimmed, dict[trimmed]);
            return;
        }
        // 2. Substring replacement (longest keys first to avoid partial clobbers)
        var newText = orig;
        var changed = false;
        var keys = Object.keys(dict).sort(function(a,b){ return b.length - a.length; });
        for (var i = 0; i < keys.length; i++) {
            var k = keys[i];
            if (newText.indexOf(k) !== -1) {
                newText = newText.split(k).join(dict[k]);
                changed = true;
            }
        }
        if (changed) {
            if (!saved.has(node)) saved.set(node, orig);
            node.textContent = newText;
        }
    }

    function applyLang(lang) {
        if (lang === 'pt') {
            // Restore every saved node
            saved.forEach(function(origVal, node) {
                if (node.nodeType === 3) { // Text node
                    node.textContent = origVal;
                } else if (node.tagName === 'INPUT' || node.tagName === 'TEXTAREA' || node.tagName === 'SELECT') {
                    node.placeholder = origVal;
                }
            });
            saved.clear();
            document.documentElement.lang = 'pt-PT';
        } else {
            var dict = PT_EN; // only EN supported for now

            // --- Walk ALL text nodes in <body> ---
            var walker = document.createTreeWalker(
                document.body,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode: function(node) {
                        var p = node.parentElement;
                        if (!p) return NodeFilter.FILTER_REJECT;
                        // Skip script/style and the toggle buttons
                        var tag = p.tagName;
                        if (tag === 'SCRIPT' || tag === 'STYLE') return NodeFilter.FILTER_REJECT;
                        if (p.id === 'langToggle' || p.id === 'themeToggle') return NodeFilter.FILTER_REJECT;
                        return NodeFilter.FILTER_ACCEPT;
                    }
                }
            );
            var nodes = [];
            var n;
            while ((n = walker.nextNode())) nodes.push(n);
            nodes.forEach(function(textNode) { translateTextNode(textNode, dict); });

            // --- Placeholders ---
            document.querySelectorAll('[placeholder]').forEach(function(el) {
                var v = el.placeholder;
                if (dict[v]) {
                    if (!saved.has(el)) saved.set(el, v);
                    el.placeholder = dict[v];
                }
            });

            // --- data-i18n attribute (explicit key) ---
            document.querySelectorAll('[data-i18n]').forEach(function(el) {
                var key = el.getAttribute('data-i18n');
                if (dict[key]) {
                    if (!saved.has(el)) saved.set(el, el.textContent);
                    el.textContent = dict[key];
                }
            });

            document.documentElement.lang = 'en';
        }
        var btn = document.getElementById('langToggle');
        if (btn) btn.textContent = lang === 'pt' ? 'EN' : 'PT';
        currentLang = lang;
    }

    document.addEventListener('DOMContentLoaded', function() {
        var btn = document.getElementById('langToggle');
        if (btn) {
            btn.textContent = 'EN';
            btn.addEventListener('click', function() {
                applyLang(currentLang === 'pt' ? 'en' : 'pt');
            });
        }
    });
})();
</script>
</body>
</html>